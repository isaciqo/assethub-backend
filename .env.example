PORT=3000
NODE_ENV=development

# Dev local (mesmo Mongo do MEDagenda, banco separado):
MONGODB_URI=mongodb://localhost:27017/assethub
# Dentro do Docker, apontando pro Mongo que já roda na máquina:
# MONGODB_URI=mongodb://host.docker.internal:27017/assethub
# Nome do banco (manda sobre o que vier no link — dá para usar o link de outro sistema
# no mesmo cluster sem misturar dados):
MONGODB_DB_NAME=assethub

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=gere_com_crypto_randomBytes_64_minimo
JWT_REFRESH_SECRET=gere_com_valor_diferente_do_access
# Conferência em campo pode durar horas — access token mais longo que no MEDagenda,
# o refresh continua cobrindo a volta de um período longo offline.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# URL(s) do frontend autorizadas pelo CORS (separar por vírgula)
FRONTEND_URL=http://localhost:8080,http://localhost:5173

# URL pública do frontend — vai no QR Code de verificação impresso no termo em PDF
PUBLIC_APP_URL=http://localhost:8080

# Popular o banco com dados SINTÉTICOS na primeira subida (banco vazio)
SEED_ON_START=true
